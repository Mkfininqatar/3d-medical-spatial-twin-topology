import json
import logging
from typing import Dict, List, Any

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")

class SpatialTopologyMapper:
    def __init__(self, grid_resolution: str = "micrometric"):
        self.grid_resolution = grid_resolution

    def map_cardio_neural_axis(self, heart_signals: List[float], brain_signals: List[float], timestamp: int) -> str:
        """Maps binary and scalar telemetry streams into a structured 3D spatial topology JSON payload."""
        topology_node = {
            "timestamp_us": timestamp,
            "resolution": self.grid_resolution,
            "axes": {
                "cardiac_vector": self._aggregate_vector(heart_signals),
                "neural_vector": self._aggregate_vector(brain_signals)
            },
            "topology_status": "synchronized_stable"
        }
        return json.dumps(topology_node, indent=2)

    def _aggregate_vector(self, signals: List[float]) -> Dict[str, float]:
        if not signals:
            return {"x": 0.0, "y": 0.0, "z": 0.0, "magnitude": 0.0}
        
        x = sum(signals) / len(signals)
        y = signals[-1] if signals else 0.0
        z = float(len(signals))
        magnitude = (x**2 + y**2 + z**2) ** 0.5
        
        return {"x": round(x, 4), "y": round(y, 4), "z": round(z, 4), "magnitude": round(magnitude, 4)}
import numpy as np
import json
import hashlib
import hmac
from datetime import datetime

class MedicalSpatialTopologyEngine:
    def __init__(self, node_id, secret_key):
        self.node_id = node_id
        self.secret_key = secret_key.encode('utf-8')

    def aggregate_vector_stream(self, spatial_coordinates, vector_intensities):
        # High-resolution vector aggregation for 3D medical spatial mapping
        coords_array = np.array(spatial_coordinates)
        intensities_array = np.array(vector_intensities)
        
        aggregated_vector = np.dot(coords_array.T, intensities_array) / np.sum(intensities_array)
        magnitude = np.linalg.norm(aggregated_vector)
        
        payload = {
            "spatial_centroid": aggregated_vector.tolist(),
            "vector_magnitude": float(magnitude),
            "node_origin": self.node_id,
            "timestamp_ns": datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S.%f')[:-3]
        }
        
        # Secure HMAC enclave wrapping for compliance
        payload_str = json.dumps(payload, sort_keys=True)
        signature = hmac.new(self.secret_key, payload_str.encode('utf-8'), hashlib.sha256).hexdigest()
        
        return {
            "spatial_envelope": payload,
            "hmac_signature": signature
        }

