from datetime import datetime

class NationalVisionComplianceEnclave:
    def __init__(self, enclave_id, national_vision_code="QNV-2030-SECURE"):
        self.enclave_id = enclave_id
        self.national_vision_code = national_vision_code
        self.master_compliance_key = hashlib.sha256(national_vision_code.encode('utf-8')).digest()

    def generate_secure_enclave_envelope(self, payload_dict):
        # Serialize telemetry or HPC grid data to canonical JSON string
        payload_string = json.dumps(payload_dict, sort_keys=True)
        timestamp = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S.%f')[:-3]
        
        # Construct secure header
        header = {
            "enclave_id": self.enclave_id,
            "compliance_standard": self.national_vision_code,
            "timestamp_utc": timestamp
        }
        header_string = json.dumps(header, sort_keys=True)
        
        # Compute HMAC/SHA-256 Signature across header and payload for end-to-end integrity
        signing_payload = f"{header_string}.{payload_string}".encode('utf-8')
        enclave_signature = hmac.new(self.master_compliance_key, signing_payload, hashlib.sha256).hexdigest()
        
        secure_envelope = {
            "header": header,
            "payload": payload_dict,
            "enclave_hmac_signature": enclave_signature,
            "compliance_status": "VERIFIED_SECURE"
        }
        return secure_envelope

    def verify_enclave_envelope(self, secure_envelope):
        header_string = json.dumps(secure_envelope["header"], sort_keys=True)
        payload_string = json.dumps(secure_envelope["payload"], sort_keys=True)
        
        signing_payload = f"{header_string}.{payload_string}".encode('utf-8')
        expected_signature = hmac.new(self.master_compliance_key, signing_payload, hashlib.sha256).hexdigest()
        
        is_authentic = hmac.compare_digest(expected_signature, secure_envelope["enclave_hmac_signature"])
        return is_authentic

