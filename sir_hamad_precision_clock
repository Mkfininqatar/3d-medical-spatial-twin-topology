    ledger = SirHamadCryptographicLedger()
    
    # Adding sample telemetry records secured with SHA-256 block-chaining
    ledger.add_telemetry_record(92, "STABLE (Safe Zone)")
    ledger.add_telemetry_record(82, "WARNING (Block Zone)")
    
    print("\nFinal Cryptographic Ledger Chain:")
